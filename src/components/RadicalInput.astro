  */

  function renderAll() {
    renderPositions();
    renderAllomorphs();
    renderPeripheral();
    renderMatched();
    setButtonsState();
  }

  // --- Event wiring ----------------------------------------------

  posRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.rad-pos-btn');
    if (!btn) return;
    const pos = btn.dataset.radPosition as UiPos;
    if (!pos) return;
    // Clicking the same position = no-op (keep selection stable, unlike the old toggle behavior).
    // Different position → switch position, clear allomorph, clear peripheral prefix.
    if (pos !== selectedPosition) {
      selectedPosition = pos;
      selectedAllomorph = null;
      peripheralPrefix = [];
    }
    emit();
    renderAll();
  });

  alloEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.rad-allo-btn');
    if (!btn) return;
    const glyph = btn.dataset.radAlloGlyph as string;
    const position = btn.dataset.radAlloPos as RadicalPosition;
    if (!glyph || !position) return;
    if (selectedAllomorph && selectedAllomorph.glyph === glyph && selectedAllomorph.position === position) {
      // toggle off = clear allomorph only
      selectedAllomorph = null;
    } else {
      selectedAllomorph = { glyph, position };
      // ensure position syncs if user somehow clicked allo from different pos row
      selectedPosition = position;
      // clear peripheral prefix when switching allomorphs for a clean start
      peripheralPrefix = [];
    }
    emit();
    renderAll();
  });

  const padStroke = root.querySelectorAll<HTMLButtonElement>('.rad-per-stroke');
  for (const btn of padStroke) {
    btn.addEventListener('click', () => {
      const s = btn.dataset.stroke as Stroke5;
      if (!s) return;
      peripheralPrefix.push(s);
      emit();
      renderAll();
    });
  }
  function charToStrokeKey(upper: string): Stroke5 | null {
    if ('QWERT'.includes(upper)) return '一';
    if ('YUIOP'.includes(upper)) return '丨';
    if ('HJKL'.includes(upper)) return '丿';
    if ('ASDFG'.includes(upper)) return '丶';
    if ('ZXCVBNM'.includes(upper)) return '𠃊';
    if (upper === ' ' || upper === '*' || upper === '?') return '通配';
    return null;
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') return;
    const upper = e.key.toUpperCase();
    if (upper === 'BACKSPACE') {
      if (!root.isConnected) return;
      if (root.classList.contains('hidden')) return;
      if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) return;
      e.preventDefault();
      undoLast();
      return;
    }
    if (root.classList.contains('hidden')) return;
    if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) return;
    const s = charToStrokeKey(upper);
    if (!s) return;
    e.preventDefault();
    peripheralPrefix.push(s);
    emit();
    renderAll();
  });

  matchedEl.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
    if (link) return;
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.rad-char-btn');
    if (!btn) return;
    const ch = btn.dataset.radChar as string;
    if (!ch) return;
    committedChars.push(ch);
    // Reset current filter state so user can start selecting next char in the multi-char word
    peripheralPrefix = [];
    selectedAllomorph = null;

    emit();
    renderAll();
  });

  function undoLast() {
    if (peripheralPrefix.length > 0) {
      peripheralPrefix.pop();
    } else if (selectedAllomorph) {
      selectedAllomorph = null;
    } else if (committedChars.length > 0) {
      committedChars.pop();
    } else if (selectedPosition !== '__none__') {
      // revert to default 无部首
      selectedPosition = '__none__';
      selectedAllomorph = null;
    } else {
      return;
    }
    emit();
    renderAll();
  }
  undoBtn.addEventListener('click', undoLast);
  clearBtn.addEventListener('click', () => {
    selectedPosition = '__none__';
    selectedAllomorph = null;
    peripheralPrefix = [];
    committedChars = [];
    emit();
    renderAll();
  });
  // Sync committed chars from the shared DictionarySearch state when the OTHER panel
  // (StrokeInput) is the source of a commit change. Prevents stale committedChars
  // when user switches modalities between strokes and radicals.
  root.addEventListener('committedSyncFromSearch', ((e: Event) => {
    const ce = e as CustomEvent<{ committedChars?: string[] }>;
    if (Array.isArray(ce.detail?.committedChars)) {
      const prevLen = committedChars.length;
      const newLen = ce.detail.committedChars.length;
      committedChars = ce.detail.committedChars.slice();
      // If the new shared committed is SHORTER than before (user popped via other modality)
      // AND we have a current peripheral prefix / allomorph / position — keep them so user
      // can continue selecting the next char. Only clear filter state if shared committed
      // was just fully reset AND we had no filter selection already.
      if (newLen === 0 && prevLen > 0) {
        peripheralPrefix = [];
        selectedAllomorph = null;
        selectedPosition = '__none__';
      } else if (newLen > prevLen && peripheralPrefix.length === 0 && !selectedAllomorph) {
        // User committed a char via OTHER modality; reset our per-char filter so they can
        // pick the next char cleanly in this modality
        peripheralPrefix = [];
        selectedAllomorph = null;
      }
      // Don't re-emit() here: the sync event is one-way FROM parent (DictionarySearch)
      // to this panel. Re-emitting would create a redundant event cycle. Just update UI.
      renderAll();
    }
  }) as EventListener);

  // Initial render (default = 无部首 selected → char list already filtered to undifferentiated)
  renderAll();

</script>
