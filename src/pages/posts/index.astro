---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('posts');
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="Posts / 随笔 - 大家学华语">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-serif font-bold text-cinnabar pb-3 border-b border-border-warm mb-4">
        Posts / 随笔
      </h1>
      <p class="text-ink-muted font-serif leading-relaxed">
        Studio dispatches, casual notes, and contemporary reflections bridging ancient linguistic constructs with modern realities.
      </p>
    </div>

    <div class="space-y-8 mt-8">
      {posts.length > 0 ? (
        posts.map((post) => (
          <article class="border-b border-border-warm pb-6">
            <div class="text-xs font-sans text-ink-muted mb-1">
              {post.data.date} <span class="mx-1">•</span> 随笔 Post
            </div>
            <h2 class="text-xl font-serif font-bold mb-2">
              <a href={`/posts/${post.id}`} class="no-underline text-ink hover:text-cinnabar transition">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="text-ink-muted font-serif text-[0.95rem] leading-relaxed mb-3">
                {post.data.description}
              </p>
            )}
            <a href={`/posts/${post.id}`} class="inline-block text-xs font-sans font-semibold text-jade hover:text-ink transition">
              Read dispatch →
            </a>
          </article>
        ))
      ) : (
        <p class="text-ink-muted italic">No posts published yet.</p>
      )}
    </div>
  </div>
</Layout>