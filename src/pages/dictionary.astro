---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DictionarySearch from '../components/DictionarySearch.astro';
import StrokeInputClient from '../components/StrokeInput.astro';
import { buildDualIndex } from '../utils/dictionaryIndex';

const characters = await getCollection('characters');
const words = await getCollection('words');
const dualIndex = buildDualIndex(characters as any, words as any);

const { byFirstChar, byLastChar, byEqualFirstChar, byEqualLastChar, allChars, allWords } = dualIndex;

const firstCharGroups = [...byFirstChar.entries()].sort(([a], [b]) => a.localeCompare(b, 'zh-Hans-CN'));
const lastCharGroups = [...byLastChar.entries()].sort(([a], [b]) => a.localeCompare(b, 'zh-Hans-CN'));
const equalFirstCharGroups = [...byEqualFirstChar.entries()].sort(([a], [b]) => a.localeCompare(b, 'zh-Hans-CN'));
const equalLastCharGroups = [...byEqualLastChar.entries()].sort(([a], [b]) => a.localeCompare(b, 'zh-Hans-CN'));

const equalWordIdsByChar = new Map<string, Set<string>>();
for (const [ch, arr] of byEqualFirstChar) {
  if (!equalWordIdsByChar.has(ch)) equalWordIdsByChar.set(ch, new Set());
  for (const w of arr) equalWordIdsByChar.get(ch)!.add(w.id);
}
for (const [ch, arr] of byEqualLastChar) {
  if (!equalWordIdsByChar.has(ch)) equalWordIdsByChar.set(ch, new Set());
  for (const w of arr) equalWordIdsByChar.get(ch)!.add(w.id);
}
const wordById = new Map(allWords.map((w) => [w.id, w]));
const equalGroupsCombined: Array<[string, any[]]> = [];
for (const [ch, ids] of equalWordIdsByChar) {
  const list = [...ids].map((id) => wordById.get(id)).filter(Boolean);
  list.sort((a: any, b: any) => a.data.word.localeCompare(b.data.word, 'zh-Hans-CN'));
  equalGroupsCombined.push([ch, list]);
}
equalGroupsCombined.sort(([a], [b]) => a.localeCompare(b, 'zh-Hans-CN'));
---

<Layout title="字典 · Dictionary — 大家学华语">
  <div class="space-y-6">
    <div>
      <nav class="text-xs font-sans text-ink-muted uppercase tracking-wider mb-3">
        <span>字典</span> <span class="mx-1">•</span> <span>Dictionary</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-ink mb-2">
        字典 · Chinese Dictionary
      </h1>
      <p class="text-ink-muted font-serif leading-relaxed">
        A structural-linguistic index of <span class="font-semibold text-ink">{allChars.length}</span> characters (字) and{' '}
        <span class="font-semibold text-ink">{allWords.length}</span> compounds (词). Words are classified by semantic weight:
        <span class="inline-block mx-1 px-2 py-0.5 rounded bg-jade/10 text-jade border border-jade/30 text-xs font-sans align-middle">
          首重 First-Leaning
        </span>
        where the first character carries the root meaning,
        <span class="inline-block mx-1 px-2 py-0.5 rounded bg-amber-500/10 text-amber-700 border border-amber-400/40 text-xs font-sans align-middle">
          并重 Equal-Weight
        </span>
        for coordinate/parallel compounds (联合式) of equal structural weight, and
        <span class="inline-block mx-1 px-2 py-0.5 rounded bg-cinnabar/10 text-cinnabar border border-cinnabar/30 text-xs font-sans align-middle">
          尾重 Last-Leaning
        </span>
        where the trailing character is the categorical noun.
      </p>
    </div>

    <DictionarySearch />

    <div id="tabs-container" class="space-y-4">
      <div class="flex gap-2 flex-wrap border-b border-border-warm pb-2 select-none" role="tablist">
        <button
          type="button"
          data-dict-tab="chars"
          class="dict-tab is-active px-4 py-2 rounded-lg text-sm font-medium font-serif transition border border-transparent hover:bg-paper-card"
          aria-controls="panel-chars"
        >
          <span class="mr-1 font-bold text-lg">字</span>
          <span class="text-ink-muted text-xs uppercase tracking-wider">Characters · {allChars.length}</span>
        </button>
        <button
          type="button"
          data-dict-tab="words"
          class="dict-tab px-4 py-2 rounded-lg text-sm font-medium font-serif transition border border-transparent hover:bg-paper-card"
          aria-controls="panel-words"
        >
          <span class="mr-1 font-bold text-lg">词</span>
          <span class="text-ink-muted text-xs uppercase tracking-wider">Words · {allWords.length}</span>
        </button>
      </div>

      <section id="panel-chars" data-dict-panel="chars" class="dict-panel space-y-3">
        <div id="char-stroke-empty" class="hidden text-center rounded-xl p-4 border border-dashed border-border-warm bg-white/50 text-sm text-ink-muted italic font-serif">
          无匹配字符 — 请撤销或清空笔画输入。No matching characters for this stroke prefix.
        </div>
        <div id="stroke-char-count" class="hidden text-xs text-ink-muted font-sans mb-1">
          匹配字符 · Matched characters: <span id="stroke-char-count-n" class="font-semibold text-ink"></span>
        </div>
        <div id="panel-chars-grid" class="grid grid-cols-[repeat(auto-fill,minmax(6rem,1fr))] gap-2">
          {allChars.map((c) => {
            const seq = c.data.strokeSequence ?? [];
            return (
            <a
              href={`/characters/${c.id}`}
              class="wiki-term char-card group flex flex-col items-center justify-center p-3 rounded-xl bg-paper-card border border-border-warm hover:border-cinnabar hover:shadow-sm transition"
              data-char={c.data.char}
              data-stroke-seq={JSON.stringify(seq)}
            >
              <span class="text-3xl font-serif font-bold text-ink group-hover:text-cinnabar transition leading-tight">
                {c.data.char}
              </span>
              <span class="text-[11px] font-mono text-ink-muted mt-1">{c.data.pinyin}</span>
              {(() => {
                const fc = byFirstChar.get(c.data.char)?.length ?? 0;
                const lc = byLastChar.get(c.data.char)?.length ?? 0;
                const ef = byEqualFirstChar.get(c.data.char)?.length ?? 0;
                const el = byEqualLastChar.get(c.data.char)?.length ?? 0;
                const eqSet = new Set([
                  ...(byEqualFirstChar.get(c.data.char)?.map((w: any) => w.id) ?? []),
                  ...(byEqualLastChar.get(c.data.char)?.map((w: any) => w.id) ?? []),
                ]);
                const total = fc + lc + eqSet.size;
                return total > 0 ? (
                  <span class="text-[9px] font-sans text-ink-muted mt-0.5">{total} 词</span>
                ) : null;
              })()}
            </a>
          );})}
        </div>
      </section>

      <section id="panel-words" data-dict-panel="words" class="dict-panel hidden space-y-4">
        <div
          class="inline-flex rounded-xl p-1 bg-paper-card border border-border-warm shadow-2xs flex-wrap"
          role="tablist"
          aria-label="Structure classification"
        >
          <button
            type="button"
            data-structure-view="all"
            class="struct-tab is-active px-3 py-1.5 rounded-lg text-xs font-bold font-sans tracking-wide transition"
          >
            全部 · All
          </button>
          <button
            type="button"
            data-structure-view="first"
            class="struct-tab px-3 py-1.5 rounded-lg text-xs font-bold font-sans tracking-wide transition"
          >
            首重 · First
          </button>
          <button
            type="button"
            data-structure-view="equal"
            class="struct-tab px-3 py-1.5 rounded-lg text-xs font-bold font-sans tracking-wide transition"
          >
            并重 · Equal
          </button>
          <button
            type="button"
            data-structure-view="last"
            class="struct-tab px-3 py-1.5 rounded-lg text-xs font-bold font-sans tracking-wide transition"
          >
            尾重 · Last
          </button>
        </div>

        <div data-struct-group="all" class="struct-group space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {allWords.map((w) => (
              <a
                href={`/words/${w.id}`}
                class="wiki-term block p-3 rounded-xl bg-paper-card border border-border-warm hover:border-cinnabar hover:shadow-sm transition"
              >
                <div class="flex items-baseline gap-2 flex-wrap mb-1">
                  <span class="text-xl font-serif font-bold text-ink">{w.data.word}</span>
                  <span class="text-xs font-mono text-cinnabar">{w.data.pinyin}</span>
                  <span
                    class={`ml-auto text-[10px] font-sans font-bold uppercase tracking-wide px-1.5 py-0.5 rounded border ${
                      w.data.structureType === 'first'
                        ? 'bg-jade/10 text-jade border-jade/30'
                        : w.data.structureType === 'equal'
                        ? 'bg-amber-500/10 text-amber-700 border-amber-400/40'
                        : 'bg-cinnabar/10 text-cinnabar border-cinnabar/30'
                    }`}
                  >
                    {w.data.structureType === 'first' ? '首重' : w.data.structureType === 'equal' ? '并重' : '尾重'}
                  </span>
                </div>
                <p class="text-xs text-ink-muted m-0 leading-snug line-clamp-2">{w.data.definition}</p>
              </a>
            ))}
          </div>
        </div>

        <div data-struct-group="first" class="struct-group hidden space-y-8">
          {firstCharGroups.map(([ch, wordList]) => (
            <div class="space-y-3">
              <div class="flex items-center gap-3 pb-2 border-b border-border-warm">
                <a
                  href={`/characters/${ch}`}
                  class="wiki-term flex items-center justify-center w-12 h-12 rounded-xl bg-jade/10 text-jade border border-jade/30 text-2xl font-serif font-bold hover:bg-jade hover:text-white transition shrink-0"
                >
                  {ch}
                </a>
                <div>
                  <div class="font-serif text-sm font-bold text-ink">
                    首重词 {wordList.length} 条
                  </div>
                  <div class="text-xs text-ink-muted">
                    Root meaning on <span class="text-jade font-semibold">{ch}</span> as leading character
                  </div>
                </div>
              </div>
              <ul class="list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-2">
                {wordList.map((w) => (
                  <li>
                    <a
                      href={`/words/${w.id}`}
                      class="wiki-term block p-2.5 rounded-lg bg-paper-card border border-border-warm hover:border-jade hover:shadow-2xs transition"
                    >
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="font-serif font-bold text-ink">
                          <span class="text-jade">{w.data.word.charAt(0)}</span>{w.data.word.slice(1)}
                        </span>
                        <span class="text-[11px] font-mono text-cinnabar">{w.data.pinyin}</span>
                      </div>
                      <p class="text-[11px] text-ink-muted mt-0.5 m-0 leading-snug line-clamp-1">
                        {w.data.definition}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div data-struct-group="equal" class="struct-group hidden space-y-8">
          {equalGroupsCombined.map(([ch, wordList]) => (
            <div class="space-y-3">
              <div class="flex items-center gap-3 pb-2 border-b border-border-warm">
                <a
                  href={`/characters/${ch}`}
                  class="wiki-term flex items-center justify-center w-12 h-12 rounded-xl bg-amber-500/10 text-amber-700 border border-amber-400/40 text-2xl font-serif font-bold hover:bg-amber-500 hover:text-white transition shrink-0"
                >
                  {ch}
                </a>
                <div>
                  <div class="font-serif text-sm font-bold text-ink">
                    并重词 {wordList.length} 条
                  </div>
                  <div class="text-xs text-ink-muted">
                    Coordinate/parallel compounds where <span class="text-amber-700 font-semibold">{ch}</span> is one of two equal-weight graphemes
                  </div>
                </div>
              </div>
              <ul class="list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-2">
                {wordList.map((w: any) => (
                  <li>
                    <a
                      href={`/words/${w.id}`}
                      class="wiki-term block p-2.5 rounded-lg bg-paper-card border border-border-warm hover:border-amber-500 hover:shadow-2xs transition"
                    >
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="font-serif font-bold text-ink">
                          {w.data.word.split('').map((c: string, i: number) => (
                            <span class="text-amber-600">{c}</span>
                          ))}
                        </span>
                        <span class="text-[11px] font-mono text-cinnabar">{w.data.pinyin}</span>
                      </div>
                      <p class="text-[11px] text-ink-muted mt-0.5 m-0 leading-snug line-clamp-1">
                        {w.data.definition}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div data-struct-group="last" class="struct-group hidden space-y-8">
          {lastCharGroups.map(([ch, wordList]) => (
            <div class="space-y-3">
              <div class="flex items-center gap-3 pb-2 border-b border-border-warm">
                <a
                  href={`/characters/${ch}`}
                  class="wiki-term flex items-center justify-center w-12 h-12 rounded-xl bg-cinnabar/10 text-cinnabar border border-cinnabar/30 text-2xl font-serif font-bold hover:bg-cinnabar hover:text-white transition shrink-0"
                >
                  {ch}
                </a>
                <div>
                  <div class="font-serif text-sm font-bold text-ink">
                    尾重词 {wordList.length} 条
                  </div>
                  <div class="text-xs text-ink-muted">
                    <span class="text-cinnabar font-semibold">{ch}</span> as categorical noun (trailing anchor)
                  </div>
                </div>
              </div>
              <ul class="list-none p-0 grid grid-cols-1 md:grid-cols-2 gap-2">
                {wordList.map((w) => (
                  <li>
                    <a
                      href={`/words/${w.id}`}
                      class="wiki-term block p-2.5 rounded-lg bg-paper-card border border-border-warm hover:border-cinnabar hover:shadow-2xs transition"
                    >
                      <div class="flex items-baseline gap-2 flex-wrap">
                        <span class="font-serif font-bold text-ink">
                          {w.data.word.slice(0, -1)}<span class="text-cinnabar">{w.data.word.charAt(w.data.word.length - 1)}</span>
                        </span>
                        <span class="text-[11px] font-mono text-cinnabar">{w.data.pinyin}</span>
                      </div>
                      <p class="text-[11px] text-ink-muted mt-0.5 m-0 leading-snug line-clamp-1">
                        {w.data.definition}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.dict-tab');
    const panels = document.querySelectorAll<HTMLElement>('.dict-panel');
    const structTabs = document.querySelectorAll<HTMLButtonElement>('.struct-tab');
    const structGroups = document.querySelectorAll<HTMLElement>('.struct-group');
    const updateTabs = (activeId: string) => {
      tabs.forEach((t) => {
        const isActive = t.dataset.dictTab === activeId;
        t.classList.toggle('is-active', isActive);
        t.classList.toggle('bg-white', isActive);
        t.classList.toggle('border-border-warm', isActive);
        t.classList.toggle('shadow-2xs', isActive);
        t.setAttribute('aria-selected', String(isActive));
      });
      panels.forEach((p) => {
        p.classList.toggle('hidden', p.dataset.dictPanel !== activeId);
      });
    };
    tabs.forEach((t) => {
      t.addEventListener('click', () => updateTabs(t.dataset.dictTab!));
    });
    updateTabs('chars');

    const updateStruct = (view: string) => {
      structTabs.forEach((t) => {
        const isActive = t.dataset.structureView === view;
        t.classList.toggle('is-active', isActive);
        t.classList.toggle('bg-white', isActive);
        t.classList.toggle('text-ink', isActive);
        t.classList.toggle('text-ink-muted', !isActive);
        t.setAttribute('aria-selected', String(isActive));
      });
      structGroups.forEach((g) => {
        g.classList.toggle('hidden', g.dataset.structGroup !== view);
      });
      if (location.hash === `#view-${view}`) return;
      history.replaceState(null, '', `#view-${view}`);
    };
    structTabs.forEach((t) => {
      t.addEventListener('click', () => updateStruct(t.dataset.structureView!));
    });
    const hashMatch = location.hash.match(/^#view-(all|first|equal|last)$/);
    if (hashMatch) updateStruct(hashMatch[1]);
    else updateStruct('all');

    type StrokeType = '横' | '竖' | '撇' | '点' | '折' | '通配';
    const charCards = document.querySelectorAll<HTMLElement>('#panel-chars-grid .char-card');
    const emptyTip = document.getElementById('char-stroke-empty')!;
    const countWrap = document.getElementById('stroke-char-count')!;
    const countN = document.getElementById('stroke-char-count-n')!;
    function strokeMatchesChar(seq: StrokeType[] | undefined, prefix: StrokeType[]): boolean {
      if (prefix.length === 0) return true;
      if (!seq || seq.length < prefix.length) return false;
      for (let i = 0; i < prefix.length; i++) {
        const s = prefix[i];
        if (s === '通配') continue;
        if (seq[i] !== s) return false;
      }
      return true;
    }
    function strokeFilter(prefix: StrokeType[]) {
      if (!prefix.length) {
        let total = 0;
        charCards.forEach((el) => {
          el.classList.remove('hidden');
          total++;
        });
        emptyTip.classList.add('hidden');
        countWrap.classList.add('hidden');
        return;
      }
      let visible = 0;
      charCards.forEach((el) => {
        const raw = el.getAttribute('data-stroke-seq');
        let seq: StrokeType[] = [];
        try { if (raw) seq = JSON.parse(raw); } catch {}
        if (strokeMatchesChar(seq, prefix)) { el.classList.remove('hidden'); visible++; }
        else el.classList.add('hidden');
      });
      if (visible === 0) emptyTip.classList.remove('hidden');
      else emptyTip.classList.add('hidden');
      countWrap.classList.remove('hidden');
      countN.textContent = String(visible);
    }
    const strokeRoot = document.getElementById('stroke-input-root');
    if (strokeRoot) {
      strokeRoot.addEventListener('strokeInputChange', ((e: Event) => {
        const detail = (e as CustomEvent).detail as {
          prefix: StrokeType[];
          currentSlotPrefix?: StrokeType[];
          committedChars?: string[];
        };
        const prefix = detail.currentSlotPrefix ?? detail.prefix ?? [];
        strokeFilter(prefix, Array.isArray(detail.committedChars) ? detail.committedChars : undefined);
      }) as EventListener);
    }
  </script>
</Layout>
