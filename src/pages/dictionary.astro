---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DictionarySearch from '../components/DictionarySearch.astro';

const characters = await getCollection('characters');
const words = await getCollection('words');
---

<Layout title="字典 · Dictionary — 大家学华语">
  <div class="space-y-6">
    <div>
      <nav class="text-xs font-sans text-ink-muted uppercase tracking-wider mb-3">
        <span>字典</span> <span class="mx-1">•</span> <span>Dictionary</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-ink mb-2">
        字典 · Chinese Dictionary
      </h1>
      <p class="text-ink-muted font-serif leading-relaxed">
        A structural-linguistic index of <span class="font-semibold text-ink">{characters.length}</span> characters (字) and{' '}
        <span class="font-semibold text-ink">{words.length}</span> compounds (词). Use the 部首/偏旁检索 panel below to drill down by position → allomorph → peripheral strokes, click characters to open their full entries, or commit multiple characters to build multi-character word searches.
      </p>
    </div>

    <DictionarySearch />
  </div>
</Layout>
