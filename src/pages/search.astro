---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search - Philosophy Wiki">
  <h1 style="margin-top: 0;">Search the Wiki</h1>
  <p style="color: #666; margin-bottom: 2rem;">Search across all terms, propositions, and foundational texts.</p>

  {/* Pagefind CSS & UI container */}
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" type="text/javascript"></script>

  <div id="search" style="max-width: 600px; margin-top: 1rem;"></div>

  <script is:inline>
    window.addEventListener('DOMContentLoaded', (event) => {
      new PagefindUI({ element: "#search", showSubResults: true });
    });
  </script>
</Layout>